<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Пример 3</title>
    <script>
        function func1(e) {
            e = e || event;
            document.title = "(" + e.clientX + "," + e.clientY + ")";
        }

        function handleKeyDown(e) {
            e = e || event;
            document.title = "Код клавиши = " + e.keyCode;
        }

        function handleMouseDown(e) {
            e = e || event;
            document.title = "Код кнопки = " + e.button;
        }

        window.onkeydown = handleKeyDown;
        window.onmousedown = handleMouseDown;
    </script>
</head>
<body style="background-color: green;" onmousemove="func1(event)">
    <p style="color:yellow">Пример использования формы с кнопками (Пример 15)</p>
    <form>
        <input type="button" value="Первая" onclick="func1(event)">
        <input type="button" value="Вторая" onmouseover="func1(event)">
        <input type="button" value="Третья" onclick="func1(event)">
    </form>
</body>
</html>
