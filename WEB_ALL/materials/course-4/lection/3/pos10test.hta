<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Пример 10</title>
    <script>
        function func1() {
            // alert('Вы нажали первую кнопку');
            window.resizeTo(500, 400);
        }

        function func2() {
            window.moveTo(50, 50);
        }

        function func3() {
            window.close(); 
        }
    </script>
</head>
<body style="background-color: green;">
    <p style="color:yellow">Пример использования формы с кнопками (Пример 10)</p>
    <form>
        <input type="button" value="Первая" onclick="func1()">
        <input type="button" value="Вторая" onclick="func2()">
        <input type="button" value="Третья" onclick="func3()">
    </form>
</body>
</html>
